<Window x:Class="SmartRestaurant.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zafaran Desktop — Restaurant OS" Height="860" Width="1460"
        WindowStartupLocation="CenterScreen" Background="#0F1420" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ sidebar ═══ -->
        <Border Grid.Column="0" Background="#121828" BorderBrush="#1E2740" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <TextBlock Text="🫖 ZAFARAN" FontSize="19" FontWeight="Bold" Foreground="#F4B942"/>
                    <TextBlock Text="RESTAURANT OS" FontSize="10" Foreground="#5B6B8C" Margin="2,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,16">
                    <Border Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="34" Height="34" Fill="#26202A" Stroke="#F4B942" StrokeThickness="1"/>
                            <TextBlock Text="👤" FontSize="14" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText" Text="—" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="RoleText" Text="—" FontSize="10.5" Foreground="#F4B942"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="⏻" FontSize="14" Background="Transparent" BorderThickness="0"
                                    Foreground="#9AA7C0" ToolTip="Sign out" Click="Logout_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                    <StackPanel x:Name="NavPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ main area ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Border Grid.Row="0" Background="#121828" BorderBrush="#1E2740" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Overview" FontSize="18" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource Badge}" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="BranchText" Text="branch" FontSize="11" Foreground="#F4B942"/>
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#4ADE80" Margin="0,0,6,0"/>
                                <TextBlock x:Name="LiveText" Text="live" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBox x:Name="BranchSelector" Width="200" Visibility="Collapsed" SelectionChanged="BranchSelector_Changed"/>
                        <Button x:Name="BellBtn" Content="🔔" FontSize="15" Background="Transparent" BorderThickness="0"
                                Margin="0,0,14,0" Click="Bell_Click" ToolTip="Notifications"/>
                        <TextBlock x:Name="ClockText" Text="" Foreground="#9AA7C0" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- content + toasts -->
            <Grid Grid.Row="1">
                <ContentControl x:Name="ContentHost" Margin="22,18,22,22"/>
                <StackPanel x:Name="ToastHost" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,10,0"/>
            </Grid>
        </Grid>

        <!-- notifications popup -->
        <Grid x:Name="BellPopup" Visibility="Collapsed" Background="#88000000" MouseDown="BellPopup_Backdrop">
            <Border Style="{StaticResource Card}" Width="420" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,60,16,0" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,14">
                        <TextBlock Text="🔔 Notifications" FontWeight="SemiBold" FontSize="15"/>
                        <Button Content="mark all read" HorizontalAlignment="Right" Background="Transparent"
                                BorderThickness="0" Foreground="#F4B942" FontSize="11" Click="MarkAll_Click"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BellList" Margin="8,0,8,12"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
